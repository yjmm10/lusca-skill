{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/product-site.schema.json",
  "title": "Lucas Product Site Data",
  "type": "object",
  "required": ["schemaVersion", "product", "author", "metrics", "updates", "features", "disclaimer"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "product": {
      "type": "object",
      "required": ["name", "slug", "tagline", "summary"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "category": { "type": "string" },
        "tagline": { "$ref": "#/$defs/localizedText" },
        "summary": { "$ref": "#/$defs/localizedText" },
        "website": { "type": "string", "format": "uri" },
        "stage": { "type": "string" }
      }
    },
    "author": {
      "type": "object",
      "required": ["name", "role", "bio"],
      "properties": {
        "name": { "type": "string" },
        "role": { "$ref": "#/$defs/localizedText" },
        "bio": { "$ref": "#/$defs/localizedText" },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "url"],
            "properties": {
              "label": { "type": "string" },
              "url": { "type": "string", "format": "uri" }
            }
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "value", "period"],
        "properties": {
          "id": { "type": "string" },
          "label": { "$ref": "#/$defs/localizedText" },
          "value": { "type": "string" },
          "unit": { "type": "string" },
          "delta": { "type": "string" },
          "period": { "type": "string" },
          "source": { "type": "string" },
          "highlight": { "type": "boolean" }
        }
      }
    },
    "updates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "date", "title", "summary"],
        "properties": {
          "id": { "type": "string" },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "title": { "$ref": "#/$defs/localizedText" },
          "summary": { "$ref": "#/$defs/localizedText" },
          "url": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "description"],
        "properties": {
          "id": { "type": "string" },
          "title": { "$ref": "#/$defs/localizedText" },
          "description": { "$ref": "#/$defs/localizedText" },
          "highlight": { "type": "boolean" }
        }
      }
    },
    "gallery": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["src", "alt"],
        "properties": {
          "src": { "type": "string" },
          "alt": { "$ref": "#/$defs/localizedText" },
          "caption": { "$ref": "#/$defs/localizedText" }
        }
      }
    },
    "faq": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "answer"],
        "properties": {
          "question": { "$ref": "#/$defs/localizedText" },
          "answer": { "$ref": "#/$defs/localizedText" }
        }
      }
    },
    "disclaimer": { "$ref": "#/$defs/localizedText" }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "required": ["zh", "en"],
      "properties": {
        "zh": { "type": "string" },
        "en": { "type": "string" }
      },
      "additionalProperties": { "type": "string" }
    }
  }
}
